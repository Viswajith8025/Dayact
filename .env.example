VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Local dev only — AI "Suggest titles" (restart npm run dev after adding). Never use VITE_ prefix.
# Use a Google AI Studio key (starts with AIza). Keys starting with AQ. will not work with Gemini API.
GEMINI_API_KEY=

# Optional — Playwright e2e (npm run test:e2e). Real Supabase user required.
DAYACT_TEST_EMAIL=
DAYACT_TEST_PASSWORD=
